{
  "name": "schematic",
  "version": "0.4.2",
  "private": true,
  "license": "MIT",
  "author": "Dodothereal",
  "description": "An offline design system reference with Color and Mono palettes.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "homepage": "http://dodothereal.me/schematic/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dodothereal/schematic.git"
  },
  "scripts": {
    "build": "node tools/bundle.mjs",
    "check": "node tools/check.mjs",
    "check:partial": "node tools/check.mjs --defer-missing",
    "test": "npm run check -- --strict && npm run test:browser",
    "test:browser": "npm run test:verify && npm run test:interactions && npm run test:refinements && npm run test:onboarding && npm run test:onboarding-motion && npm run test:library && npm run test:sortable && npm run test:workspace && npm run test:gallery && npm run test:overview-motion",
    "test:verify": "node tools/verify.mjs",
    "test:interactions": "node tools/interactions.mjs",
    "test:refinements": "node tools/refinements.mjs",
    "test:onboarding": "node tools/onboarding-checks.mjs",
    "test:onboarding-motion": "node tools/onboarding-motion-checks.mjs",
    "test:library": "node tools/library-checks.mjs",
    "test:sortable": "node tools/sortable-checks.mjs",
    "test:workspace": "node tools/workspace-checks.mjs",
    "record:walkthrough": "node tools/record-walkthrough.mjs && node tools/make-watch-page.mjs",
    "shot": "node tools/shot.mjs",
    "test:gallery": "node tools/gallery-checks.mjs",
    "test:overview-motion": "node tools/overview-motion-checks.mjs"
  }
}
